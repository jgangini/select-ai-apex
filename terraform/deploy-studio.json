{
  "schema_version": 1,
  "project_id": "select-ai-apex",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": false
  },
  "capabilities": {
    "compartment_modes": ["new", "existing"],
    "requires_genai_region": true,
    "database_profile": "new_or_existing"
  },
  "form": {
    "fields": [
      {
        "name": "autonomous_database_mode",
        "label": "Autonomous Database mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {"value": "new", "label": "Create new"},
          {"value": "existing", "label": "Use existing"}
        ]
      },
      {
        "name": "existing_autonomous_database_ocid",
        "label": "Existing Autonomous Database OCID",
        "type": "text",
        "required": false
      },
      {
        "name": "autonomous_database_version",
        "label": "Autonomous Database version",
        "type": "select",
        "required": true,
        "default": "26ai",
        "options": [
          {"value": "26ai", "label": "26ai"},
          {"value": "19c", "label": "19c"}
        ]
      },
      {
        "name": "autonomous_database_workload",
        "label": "Autonomous Database workload",
        "type": "select",
        "required": true,
        "default": "DW",
        "options": [
          {"value": "DW", "label": "Data Warehouse"},
          {"value": "OLTP", "label": "Transaction Processing"}
        ]
      },
      {
        "name": "select_ai_apex_app_id",
        "label": "APEX application",
        "type": "select",
        "required": true,
        "default": "chatdb-es-2024",
        "options": [
          {"value": "chatdb-es-2024", "label": "Autonomous DB + Select AI"},
          {"value": "ask-oracle-chatbot", "label": "Ask Oracle"}
        ]
      },
      {
        "name": "select_ai_grant_schemas",
        "label": "Schemas exposed to Select AI",
        "type": "text",
        "required": true,
        "default": "SH_DEMO"
      },
      {
        "name": "select_ai_schema_passwords",
        "label": "Existing schema passwords (JSON)",
        "type": "password",
        "required": false,
        "secret": true
      },
      {
        "name": "application_username",
        "label": "APEX workspace administrator username",
        "type": "text",
        "required": true,
        "default": "SELECT_AI_ADMIN"
      },
      {
        "name": "autonomous_database_admin_password",
        "label": "Autonomous Database ADMIN password",
        "type": "password",
        "required": true,
        "secret": true
      },
      {
        "name": "autonomous_database_wallet_password",
        "label": "Autonomous Database wallet password",
        "type": "password",
        "required": true,
        "secret": true
      },
      {
        "name": "autonomous_database_developer_password",
        "label": "APEX workspace administrator password",
        "type": "password",
        "required": true,
        "secret": true
      }
    ]
  },
  "presentation": {
    "title": "Select AI Apex",
    "summary": "Deploys a Select AI APEX experience on Autonomous Database without a persistent application VM.",
    "tags": ["APEX", "Autonomous AI Database", "Select AI", "Generative AI"],
    "image": "/assets/select-ai-apex.png",
    "image_alt": "Select AI APEX application preview",
    "href": "https://github.com/jgangini/select-ai-apex"
  },
  "run_steps": [
    {"key": "queue", "label": "Queue"},
    {"key": "credentials", "label": "OCI credentials"},
    {"key": "compartment", "label": "Compartment"},
    {"key": "policies", "label": "IAM policies"},
    {"key": "stack", "label": "APEX Terraform package"},
    {"key": "plan", "label": "Database plan"},
    {"key": "apply", "label": "Database apply"},
    {"key": "database", "label": "Autonomous Database"},
    {"key": "wallet", "label": "Database wallet"},
    {"key": "application", "label": "Select AI and APEX setup"},
    {"key": "artifacts", "label": "Wallet and APEX summary"},
    {"key": "email", "label": "Access email"},
    {"key": "complete", "label": "Ready"}
  ],
  "outputs": ["application_url", "adb_db_name", "autonomous_database_id"],
  "artifacts": ["deployment-report.md", "adb_wallet.zip"],
  "post_apply": {
    "entrypoint": "deploy/hooks/post_apply.py",
    "include_paths": ["installer", "apex/manifest.json", "data/manifest.json"],
    "secret_inputs": [
      "autonomous_database_admin_password",
      "autonomous_database_wallet_password",
      "autonomous_database_developer_password",
      "select_ai_schema_passwords"
    ],
    "timeout_seconds": 1800,
    "requires_oci_credentials": true
  }
}
